--- opendisplay-watchdog
+++ opendisplay-watchdog
@@ -376,3 +376,3 @@
         printf '%s\n' "$id" | grep -Eq '^[1-9][0-9]*$'; then
-      connected=$("$BETTERDISPLAY" get -UUID="$uuid" -connected 2>/dev/null || true)
+      connected=$("$BETTERDISPLAY" get -deviceType=Display -UUID="$uuid" -connected 2>/dev/null || true)
       # Unsupported connection management must not hide a real Apple panel.
@@ -400,3 +400,3 @@
     [ -n "$id" ] || continue
