+  identifiers=$("$BETTERDISPLAY" get -deviceType=Display -UUID="$first" -identifiers 2>/dev/null) || return 1
   id=$(identifier_value "$identifiers" displayID)
@@ -596,3 +596,3 @@
       valid_display_uuid "$uuid" || return 1
